            "index": 0
          }
        ]
      ]
    },
    "Filter Active RSS Sources": {
      "main": [
        [
          {
            "node": "Read RSS Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read RSS Feed": {
