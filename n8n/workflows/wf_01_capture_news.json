            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize RSS Items": {
      "main": [
        [
          {
            "node": "Build Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Batch": {
      "main": [
        [
          {
            "node": "Send News Bulk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
