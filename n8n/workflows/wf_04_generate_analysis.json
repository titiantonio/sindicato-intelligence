      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "function sourceItems() {\n  const names = ['Manual Trigger', 'Webhook Trigger'];\n  const items = [];\n\n  for (const name of names) {\n    try {\n      items.push(...$(name).all());\n    } catch (error) {\n      // The other trigger is not executed in this run.\n    }\n  }\n\n  return items;\n}\n\nconst items = sourceItems();\n\nconst eventIds = items\n  .flatMap(item => {\n    const json = item.json ?? {};\n    const body = json.body ?? {};\n    return [json.eventId, json.id, body.eventId, body.id];\n  })\n  .filter(value => value !== undefined && value !== null && value !== '')\n  .map(value => Number(value))\n  .filter(value => Number.isInteger(value) && value > 0);\n\nconst uniqueEventIds = [...new Set(eventIds)];\n\nreturn uniqueEventIds.map(eventId => ({ json: { eventId } }));"
      },
      "id": "normalize-event-ids",
      "name": "Normalize Event IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "notes": "WF-04 recibe eventId desde un webhook, desde otro workflow o mediante datos manuales/pinned data. Spring Boot genera y persiste el analisis."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8080/api/v1/analysis/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"eventId\": {{$json.eventId}}\n}",
        "options": {},
