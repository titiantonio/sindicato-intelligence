              "value": "={{ 'Bearer ' + $('Authenticate Backend').first().json.accessToken }}"
            }
          ]
        }
      },
      "id": "generate-analysis",
      "name": "Generate Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
