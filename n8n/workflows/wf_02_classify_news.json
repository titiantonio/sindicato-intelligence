    {
      "parameters": {
        "jsCode": "const MAX_NEWS_PER_RUN = 10;\n\nreturn $input.all()\n  .filter(item => item.json.processingStatus === 'CAPTURED')\n  .sort((a, b) => (a.json.id ?? 0) - (b.json.id ?? 0))\n  .slice(0, MAX_NEWS_PER_RUN);"
      },
      "id": "filter-captured",
      "name": "Filter Captured News",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8080/api/v1/classifications/classify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"newsId\": {{$json.id}}\n}",
        "options": {}
      },
      "id": "classify-news",
      "name": "Classify News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "onError": "continueRegularOutput"
    }
  ],
