{
  "name": "WF-02-Classify-News",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8080/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{$env.BACKEND_N8N_AUTH_EMAIL}}\",\n  \"password\": \"{{$env.BACKEND_N8N_AUTH_PASSWORD}}\"\n}",
        "options": {}
      },
      "id": "authenticate-backend",
      "name": "Authenticate Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        -260
      ],
      "notes": "Obtiene un JWT de servicio antes de invocar endpoints protegidos del backend."
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        -160
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8080/api/v1/news",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Authenticate Backend').first().json.accessToken }}"
            }
          ]
        }
      },
      "id": "get-news",
      "name": "Get News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const MAX_NEWS_PER_RUN = 1;\n\nconst news = $input.all()\n  .flatMap(item => Array.isArray(item.json) ? item.json : [item.json])\n  .filter(item => item && item.processingStatus === 'CAPTURED')\n  .sort((a, b) => (a.id ?? 0) - (b.id ?? 0))\n  .slice(0, MAX_NEWS_PER_RUN);\n\nreturn news.map(item => ({ json: item }));"
      },
      "id": "filter-captured",
      "name": "Filter Captured News",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8080/api/v1/classifications/classify",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"newsId\": {{$json.id}}\n}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Authenticate Backend').first().json.accessToken }}"
            }
          ]
        }
      },
      "id": "classify-news",
      "name": "Classify News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Authenticate Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Authenticate Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get News": {
      "main": [
        [
          {
            "node": "Filter Captured News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Captured News": {
      "main": [
        [
          {
            "node": "Classify News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authenticate Backend": {
      "main": [
        [
          {
            "node": "Get News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "wf-02-classify-news-jwt",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": [
    {
      "name": "MVP"
    },
    {
      "name": "WF-02"
    }
  ]
}
