{
  "name": "WF-03-Detect-Events",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8080/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{$env.BACKEND_N8N_AUTH_EMAIL}}\",\n  \"password\": \"{{$env.BACKEND_N8N_AUTH_PASSWORD}}\"\n}",
        "options": {}
      },
      "id": "authenticate-backend",
      "name": "Authenticate Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        -180
      ],
      "notes": "Obtiene un JWT de servicio antes de invocar endpoints protegidos del backend."
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:8080/api/v1/news",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Authenticate Backend').first().json.accessToken }}"
            }
          ]
        }
      },
      "id": "get-news",
      "name": "Get News",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().filter(item => item.json.processingStatus === 'CLASSIFIED');"
      },
      "id": "filter-classified",
      "name": "Filter Classified News",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8080/api/v1/events/detect",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"newsId\": {{$json.id}}\n}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Authenticate Backend').first().json.accessToken }}"
            }
          ]
        }
      },
      "id": "detect-event",
      "name": "Detect Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "notes": "Spring Boot ejecuta MatchEventUseCase, CreateEventUseCase y AddNewsToEventUseCase. n8n solo orquesta WF-03."
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Authenticate Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get News": {
      "main": [
        [
          {
            "node": "Filter Classified News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Classified News": {
      "main": [
        [
          {
            "node": "Detect Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authenticate Backend": {
      "main": [
        [
          {
            "node": "Get News",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
