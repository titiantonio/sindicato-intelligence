{
  "name": "WF-06-Publish-Telegram",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8080/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{$env.BACKEND_N8N_AUTH_EMAIL}}\",\n  \"password\": \"{{$env.BACKEND_N8N_AUTH_PASSWORD}}\"\n}",
        "options": {}
      },
      "id": "authenticate-backend",
      "name": "Authenticate Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        -260
      ],
      "notes": "Obtiene un JWT de servicio antes de invocar endpoints protegidos del backend."
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wf-06-publish-telegram",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "function sourceItems() {\n  const names = ['Manual Trigger', 'Webhook Trigger'];\n  const items = [];\n\n  for (const name of names) {\n    try {\n      items.push(...$(name).all());\n    } catch (error) {\n      // The other trigger is not executed in this run.\n    }\n  }\n\n  return items;\n}\n\nconst items = sourceItems();\n\nreturn items.flatMap(item => {\n  const json = item.json ?? {};\n  const body = json.body ?? {};\n  const contentId = Number(body.contentId ?? body.id ?? json.contentId ?? json.id);\n\n  if (!Number.isInteger(contentId) || contentId <= 0) {\n    return [];\n  }\n\n  return [{\n    json: {\n      contentId\n    }\n  }];\n});"
      },
      "id": "normalize-publication-request",
      "name": "Normalize Publication Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "notes": "WF-06 recibe contentId. Spring Boot valida estado APPROVED, publica en Telegram y registra la publicacion."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:8080/api/v1/publications/{{$json.contentId}}/publish",
        "sendBody": false,
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Authenticate Backend').first().json.accessToken }}"
            }
          ]
        }
      },
      "id": "publish-telegram",
      "name": "Publish Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Spring Boot ejecuta PublishContentUseCase. n8n solo orquesta WF-06 y reintenta errores de publicacion."
    }
  ],
  "connections": {
